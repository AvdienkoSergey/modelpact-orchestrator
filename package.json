{
  "name": "modelpact-orchestrator",
  "version": "1.0.1",
  "description": "Two models under one session: Claude from the terminal you already pay for, and a local one from Ollama, routed by a condition",
  "keywords": [
    "llm",
    "modelpact",
    "typescript",
    "orchestration",
    "routing",
    "multi-model",
    "ollama",
    "claude",
    "on-device"
  ],
  "license": "MIT",
  "author": "Sergey Avdienko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvdienkoSergey/modelpact-orchestrator.git"
  },
  "homepage": "https://github.com/AvdienkoSergey/modelpact-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/AvdienkoSergey/modelpact-orchestrator/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "workspaces": [
    "demo"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "check:surface": "npm run build && tsc -p tsconfig.surface.json",
    "chat": "npm run build && node dist/chat.js",
    "demo": "npm run build && npm run dev --workspace demo"
  },
  "peerDependencies": {
    "modelpact": ">=2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "modelpact": "^2.2.0",
    "modelpact-providers": "^1.2.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
